# Copy to .env.local and fill in values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=pubanon_XXXXXXXXXXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY=service_role_XXXXXXXXXXXXXXXXXXXX

# OpenAI
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_VISION_MODEL=gpt-4o
OPENAI_EXTRACTION_MODEL=gpt-4o-mini
# Privacy-first defaults. Enable only with a documented retention policy and user consent.
RETAIN_RAW_AUDIO=false
RETAIN_RECEIPTS=false

# Optional: configure default company tax rate
NEXT_PUBLIC_DEFAULT_CORPORATION_TAX_RATE=25

# TrueLayer Open Banking (sandbox defaults; never prefix secrets with NEXT_PUBLIC_)
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/api/bank-connections/callback
TRUELAYER_AUTH_URL=https://auth.truelayer-sandbox.com
TRUELAYER_API_URL=https://api.truelayer-sandbox.com
TRUELAYER_PROVIDERS=mock
OPEN_BANKING_CONSENT_DAYS=90
# Generate a long random value (at least 32 characters) and keep it stable.
BANK_TOKEN_ENCRYPTION_KEY=
